<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Coin balance alongside karma in the user form button box. -->
    <record id="view_users_form_gamification_coin" model="ir.ui.view">
        <field name="name">res.users.form.gamification.coin</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="gamification.res_users_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='karma']/.." position="after">
                <button type="object" class="oe_stat_button" groups="base.group_no_one"
                    name="action_coin_report" icon="fa-money">
                    <field string="Coins" name="coin_balance" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Manual adjustment, for Coin Managers only. -->
    <record id="view_users_form_gamification_coin_adjust" model="ir.ui.view">
        <field name="name">res.users.form.gamification.coin.adjust</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="action" class="oe_stat_button"
                    name="%(action_gamification_coin_adjust_wizard)s"
                    icon="fa-plus-square"
                    string="Adjust Coins"
                    groups="gamification_coin.group_coin_manager"
                    context="{'default_user_id': id}"/>
            </xpath>
        </field>
    </record>
</odoo>
